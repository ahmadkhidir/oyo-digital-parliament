# pnpm behaviour for this workspace.
#
# The lockfile is the single resolved record of every version, so an install that would drift from
# it fails (see `pnpm install --frozen-lockfile`, run by CI and by the phase gate).
engine-strict=true
save-exact=true
prefer-workspace-packages=true
link-workspace-packages=true
shared-workspace-lockfile=true
strict-peer-dependencies=true
auto-install-peers=true
