{
  "name": "@odp/db",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL schema, migrations, repositories, full-text search, idempotency and audit append.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node src/seeds/index.ts",
    "lint": "eslint --max-warnings 0 --no-error-on-unmatched-pattern .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run test"
  },
  "dependencies": {
    "@odp/domain": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
