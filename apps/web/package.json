{
  "name": "@odp/web",
  "version": "0.0.0",
  "private": true,
  "description": "The single deployable: public record and role-scoped /admin console as Next.js App Router route groups.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-assets.mjs",
    "build": "next build",
    "prestart": "node scripts/sync-assets.mjs",
    "start": "node --env-file-if-exists=../../.env .next/standalone/apps/web/server.js",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y"
  },
  "dependencies": {
    "@odp/db": "workspace:*",
    "@odp/domain": "workspace:*",
    "@odp/inference": "workspace:*",
    "@odp/platform": "workspace:*",
    "@odp/ui": "workspace:*",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
