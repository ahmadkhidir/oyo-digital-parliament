# Paths Prettier must not touch (ADR-003).
#
# Generated output, dependencies and caches.
node_modules/
.next/
.turbo/
dist/
build/
out/
coverage/
playwright-report/
test-results/
blob-report/

# The committed lockfile is generated by pnpm; formatting it would desynchronise it from the registry
# resolution it records.
pnpm-lock.yaml

# The specification is a git submodule owned by the documentation repository. A code task never writes
# under `docs/`, and that includes reformatting it.
docs/

# Agent and repository manuals are prose, reviewed as documentation, and several are owned by another
# task; Prettier formats code, not the product record.
*.md

# Generated design artefacts: `packages/ui/src/tokens/generate.ts` writes these from the branding
# source and a hand-format would be overwritten on the next regeneration.
packages/ui/src/styles/theme.css
packages/ui/src/styles/fonts.css
packages/ui/tailwind.preset.ts

# Binary and generated assets.
assets/**/*.svg
assets/**/*.png
assets/**/*.woff2
