# Oyo Digital Parliament - local development environment.
#
# Rendered from `infra/local/environment.mjs`, whose application variables come from
# `packages/platform/src/config/schema.ts`. Change the schema or the contract there and run
# `node scripts/dev/env.mjs render`, then `node scripts/dev/env.mjs check` to prove it.
#
# Copy this file to `.env` (or let `node scripts/dev/services.mjs up` do it) to run the local
# stack. `.env` is git-ignored and must never be committed.
#
# Every value below is a disposable local placeholder for the Development environment. There is
# no real credential in this repository: staging and production values live in the managed secret
# store, and an unset secret fails boot rather than falling back to a default (NFR-024).
#
# `process.env` wins over `.env`, so CI can inject values without a file. Validation never prints
# a value: `node scripts/dev/env.mjs check` names the missing or malformed variable instead.

# Primary Database - PostgreSQL 16 (architecture.md: Data Stores)
# Connection string for the Primary Database; used by the app, the worker and drizzle-kit.
DATABASE_URL=postgresql://odp_local:odp_local_dev_password@127.0.0.1:5433/odp_local
# Role the local PostgreSQL container creates and DATABASE_URL connects as.
POSTGRES_USER=odp_local
# Password for that role. A local placeholder only; a real secret never lives here.
POSTGRES_PASSWORD=odp_local_dev_password
# Database the container creates on first start.
POSTGRES_DB=odp_local
# Host port the container publishes; DATABASE_URL must use it. Off the standard 5432 so a PostgreSQL already installed here keeps its port.
POSTGRES_PORT=5433

# Read cache, sessions and rate-limit counters - Redis 7
# Read cache, session store and rate-limit counters. Treated as a secret because a managed URL carries a password.
REDIS_URL=redis://127.0.0.1:6380
# Host port the container publishes; REDIS_URL must use it. Off the standard 6379 so a Redis already installed here keeps its port.
REDIS_PORT=6380

# Cache lifetimes - one explicit expiry per key family (C-075, C-086)
# Lifetime of a cached public page. Short: NFR-001 measures the read path, and a publication invalidates the page explicitly.
CACHE_TTL_PUBLIC_PAGE_SECONDS=60
# Lifetime of a cached ward report read (NFR-002).
CACHE_TTL_WARD_REPORT_SECONDS=300
# Lifetime of a cached commitment register read.
CACHE_TTL_COMMITMENT_REGISTER_SECONDS=120
# Lifetime of a cached public ledger page (NFR-003).
CACHE_TTL_PUBLIC_LEDGER_SECONDS=120
# Lifetime of a cached search result page (NFR-009).
CACHE_TTL_SEARCH_SECONDS=60

# Object storage - S3-compatible, private bucket
# S3-compatible endpoint for the object store (exports, report cards, handover snapshot, evaluation artefacts).
S3_ENDPOINT=http://127.0.0.1:9100
# Region the client signs requests with.
S3_REGION=us-east-1
# Private bucket. Nothing in it is publicly readable; reads go through a signed URL.
S3_BUCKET=odp-local
# Access key for the object store.
S3_ACCESS_KEY_ID=odp-local-access-key
# Secret key for the object store.
S3_SECRET_ACCESS_KEY=odp-local-secret-key
# true when the endpoint is an address rather than a per-bucket hostname, which is the case for the local store.
S3_FORCE_PATH_STYLE=true
# Lifetime of a signed read URL, in seconds. Short by design: C-036 mints one URL for one object, for one reader.
S3_SIGNED_URL_TTL_SECONDS=900
# Host port the object store publishes; S3_ENDPOINT must use it. Off the common 9000 so another local store keeps its port.
S3_PORT=9100

# SMS gateway - notification boundary transport (C-076)
# SMS gateway behind the provider port. "none" holds every message with PROVIDER_NOT_CONFIGURED rather than pretending to deliver it.
SMS_PROVIDER=none
# Gateway endpoint the HTTP SMS adapter posts to. Required when SMS_PROVIDER is "http".
SMS_API_URL=https://sms-gateway.example.test/send
# Credential for the SMS gateway. Required when SMS_PROVIDER is "http".
SMS_API_KEY=local-sms-placeholder
# Approved sender name the gateway shows the recipient. Required when SMS_PROVIDER is "http".
SMS_SENDER_ID=ODP
# Per-attempt timeout for one SMS delivery, in milliseconds.
SMS_TIMEOUT_MS=8000
# Upper bound on delivery attempts for one message, including the first. The notification boundary owns the hold decision; this bounds the transport retry.
SMS_MAX_ATTEMPTS=3
# First retry delay in milliseconds; each further attempt doubles it.
SMS_BACKOFF_BASE_MS=500
# Ceiling on a single retry delay, in milliseconds.
SMS_BACKOFF_MAX_MS=4000

# Inference Gateway - pinned capability configuration (C-078, NFR-045)
# Model provider behind the Inference Gateway. "none" switches every capability to its deterministic fallback.
MODEL_PROVIDER=none
# Provider endpoint the Inference Gateway calls. Required when MODEL_PROVIDER is "http".
MODEL_API_URL=https://model-gateway.example.test/v1
# Provider credential. Required when MODEL_PROVIDER is "http"; never logged.
MODEL_API_KEY=local-model-placeholder
# Processing region named in the privacy notice (NFR-045). Required before inference is enabled, because the transfer is disclosed.
MODEL_REGION=ng
# Pinned model version for the similar_submission capability (C-078, NFR-050 to NFR-053).
MODEL_VERSION_SIMILAR_SUBMISSION=odp-local-sim-1
# Per-call timeout for similar_submission, in milliseconds; C-078 rewrites the caller's value from it.
MODEL_TIMEOUT_MS_SIMILAR_SUBMISSION=1500
# Spend ceiling for similar_submission in USD micros per 1,000 units (NFR-050 to NFR-053).
MODEL_COST_CEILING_MICROS_PER_THOUSAND_SIMILAR_SUBMISSION=50000
# Pinned model version for the ward_candidate capability (C-078, NFR-050 to NFR-053).
MODEL_VERSION_WARD_CANDIDATE=odp-local-ward-1
# Per-call timeout for ward_candidate, in milliseconds; C-078 rewrites the caller's value from it.
MODEL_TIMEOUT_MS_WARD_CANDIDATE=1500
# Spend ceiling for ward_candidate in USD micros per 1,000 units (NFR-050 to NFR-053).
MODEL_COST_CEILING_MICROS_PER_THOUSAND_WARD_CANDIDATE=50000
# Pinned model version for the moderation_routing capability (C-078, NFR-050 to NFR-053).
MODEL_VERSION_MODERATION_ROUTING=odp-local-route-1
# Per-call timeout for moderation_routing, in milliseconds; C-078 rewrites the caller's value from it.
MODEL_TIMEOUT_MS_MODERATION_ROUTING=1500
# Spend ceiling for moderation_routing in USD micros per 1,000 units (NFR-050 to NFR-053).
MODEL_COST_CEILING_MICROS_PER_THOUSAND_MODERATION_ROUTING=100000
# Pinned model version for the budget_line_extraction capability (C-078, NFR-050 to NFR-053).
MODEL_VERSION_BUDGET_LINE_EXTRACTION=odp-local-budget-1
# Per-call timeout for budget_line_extraction, in milliseconds; C-078 rewrites the caller's value from it.
MODEL_TIMEOUT_MS_BUDGET_LINE_EXTRACTION=1500
# Spend ceiling for budget_line_extraction in USD micros per 1,000 units (NFR-050 to NFR-053).
MODEL_COST_CEILING_MICROS_PER_THOUSAND_BUDGET_LINE_EXTRACTION=500000

# Feature flags - launch state per environment (release.md, C-069)
# Launch state for the ward_candidate_suggestions flag; the operator console changes the live value (C-069).
FEATURE_WARD_CANDIDATE_SUGGESTIONS=false
# Launch state for the similar_submission_suggestions flag; the operator console changes the live value (C-069).
FEATURE_SIMILAR_SUBMISSION_SUGGESTIONS=false
# Launch state for the moderation_routing flag; the operator console changes the live value (C-069).
FEATURE_MODERATION_ROUTING=false
# Launch state for the assisted_intake flag; the operator console changes the live value (C-069).
FEATURE_ASSISTED_INTAKE=false
# Launch state for the budget_line_extraction flag; the operator console changes the live value (C-069).
FEATURE_BUDGET_LINE_EXTRACTION=false
# Launch state for the report_card_workbench flag; the operator console changes the live value (C-069).
FEATURE_REPORT_CARD_WORKBENCH=false
# Launch state for the session_reservations flag; the operator console changes the live value (C-069).
FEATURE_SESSION_RESERVATIONS=false
